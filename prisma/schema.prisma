datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AGENT
  USER
}

enum AccountType {
  MAIN
  TRAINING
}

enum TaskStatus {
  GENERATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  CREDIT
  DEBIT
}

model User {
  id             String      @id @default(uuid())
  email          String?     @unique
  phone          String?     @unique
  username       String      @unique
  passwordHash   String
  role           Role        @default(USER)
  accountType    AccountType @default(MAIN)
  balance        Decimal     @default(0.00) @db.Decimal(12, 2)
  invitationCode String      @unique

  invitedById String?
  invitedBy   User?   @relation("Invitations", fields: [invitedById], references: [id])
  invitees    User[]  @relation("Invitations")

  parentUserId  String?
  parentUser    User?   @relation("ParentChildAccounts", fields: [parentUserId], references: [id])
  childAccounts User[]  @relation("ParentChildAccounts")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        ProductTask[]
  transactions Transaction[]

  @@index([invitationCode])
  @@index([parentUserId])
}

model Product {
  id             String   @id @default(uuid())
  title          String
  image          String
  price          Decimal  @db.Decimal(12, 2)
  commissionRate Decimal  @default(2.00) @db.Decimal(5, 2)
  commission     Decimal  @default(0.00) @db.Decimal(12, 2)
  isHomeProduct  Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks ProductTask[]
}

model ProductTask {
  id        String  @id @default(uuid())
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  priceSnapshot      Decimal  @db.Decimal(12, 2)
  commissionSnapshot Decimal  @db.Decimal(5, 2)
  earnedCommission   Decimal? @db.Decimal(12, 2)

  rating  Int?
  comment String?
  status  TaskStatus @default(GENERATED)

  generatedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, status])
}

model Transaction {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  balanceBefore Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)
  referenceType String
  referenceId   String?
  note          String?
  createdAt     DateTime        @default(now())

  @@index([userId])
}
